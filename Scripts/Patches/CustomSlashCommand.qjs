*                                                                          *
*   Author(s)     : Louis T Steinhil                                       *
*   Last Modified : 2026-06-15                                             *
*   Description   : Shared slash-command dispatcher for static native-cave *
*                   features. Commands call their registered EXE-resident  *
*                   target directly, avoiding external modules, sentinel  *
*                   files, polling, and competing hooks.                  *
*                                                                          *
\**************************************************************************/

CustomSlashCommand = {};

CustomSlashCommand.ownerPatchName = function(name)
{
	if (!IsStr(name) || name.isEmpty())
		return Exe.ActivePatch;

	const dot = name.indexOf('.');
	if (dot > 0)
		return name.substring(0, dot);

	const bracket = name.indexOf(' ');
	if (bracket > 0)
		return name.substring(0, bracket);

	return name;
};

CustomSlashCommand.ownerIsActive = function(ownerName, currentOwner)
{
	return ownerName === currentOwner || Warp.GetPatchState(ownerName);
};

CustomSlashCommand.register = function(_, spec)
{
	const hasStaticTarget = spec && Number.isInteger(spec.targetVir) && spec.targetVir > 0;
	if (!spec || !IsStr(spec.command) || !hasStaticTarget)
		throw Error(
			"CustomSlashCommand.register requires a command and static targetVir"
		);

	const command = spec.command.toLowerCase();
	if (!/^\/[a-z0-9_]+$/.test(command))
		throw Error(`Invalid custom slash command: ${spec.command}`);

	const clean = {
		command,
		targetVir: spec.targetVir,
		optionId: Number.isInteger(spec.optionId) ? spec.optionId : null
	};

	const owner = CustomSlashCommand.ownerPatchName(_);
	const key = 'CustomSlashCommand.RegistryByOwner';
	const registryByOwner = CACHE.get(key) ?? {};
	const registry = registryByOwner[owner] ?? [];
	const existing = registry.find(entry => entry.command === command);

	if (existing)
	{
		existing.targetVir = clean.targetVir;
		existing.optionId = clean.optionId;
	}
	else
	{
		registry.push(clean);
	}

	registryByOwner[owner] = registry;
	CACHE.put(key, registryByOwner);
	if (typeof PatchDiagnostics !== "undefined" &&
	    typeof PatchDiagnostics.add === "function")
		PatchDiagnostics.add('CustomSlashCommand.register', {
			owner,
			command: clean.command,
			targetVir: clean.targetVir,
			optionId: clean.optionId
		});

	return CustomSlashCommand.refresh(_);
};

CustomSlashCommand.refresh = function(_)
{
	const currentOwner = CustomSlashCommand.ownerPatchName(_);
	CACHE.put('CustomSlashCommand.CurrentRefreshOwner', currentOwner);
	const registryByOwner = CACHE.get('CustomSlashCommand.RegistryByOwner') ?? {};
	const registry = [];
	for (const owner in registryByOwner)
	{
		if (!CustomSlashCommand.ownerIsActive(owner, currentOwner))
			continue;
		for (const entry of registryByOwner[owner])
			registry.push(entry);
	}

	const callerPatch = Exe.ActivePatch;
	Exe.ActivateGlobal();
	Exe.BeginTag(CACHE.getTag('CustomSlashCommand.Dispatch'), true);

	try
	{
		if (registry.isEmpty())
			return true;

		const cmn = (ROC.HasFP ? FP_STOP : '') + RETN(4);
		let prefix, suffix, movPos, extraPops, tgtReg;

		switch (Exe.Version)
		{
			case 6:
				prefix = MOV(EAX, [R32, 4]) + POP(EDI) + POP(ESI) + POP(EBX) + cmn;
				suffix = POP(EDI) + POP(ESI) + MOV(EAX, 3) + POP(EBX) + cmn;
				movPos = 2; extraPops = POP(EDI) + POP(ESI); tgtReg = ESI; break;
			case 9:
				prefix = MOV(EAX, [R32, 4]) + POP(EDI) + POP(ESI) + POP(ECX) + cmn;
				suffix = POP(EDI) + MOV(EAX, 3) + POP(ESI) + POP(ECX) + cmn;
				movPos = 1; extraPops = POP(EDI); tgtReg = EBP; break;
			case 10: case 11:
				prefix = MOV(EAX, [R32, 4]) + cmn;
				suffix = MOV(EAX, 3) + cmn;
				movPos = 0; extraPops = ''; tgtReg = EDI; break;
			default:
				prefix = MOV(EAX, [R32, 4]) + POP(EDI) + POP(ESI) + cmn;
				suffix = POP(EDI) + MOV(EAX, 3) + POP(ESI) + cmn;
				movPos = 1; extraPops = POP(EDI); tgtReg = EDI; break;
		}

		let funcEnd = Exe.FindHex(prefix + suffix);
		if (funcEnd < 0)
		{
			let ms;
			switch (Exe.Version)
			{
				case 6: ms = POP(EDI) + POP(ESI) + XOR(EAX, EAX) + ADD(tgtReg, 1) + POP(EBX) + cmn; break;
				case 9: ms = POP(EDI) + XOR(EAX, EAX) + ADD(tgtReg, 1) + POP(ESI) + POP(ECX) + cmn; break;
				case 10: case 11: ms = XOR(EAX, EAX) + ADD(tgtReg, 1) + cmn; break;
				default: ms = POP(EDI) + XOR(EAX, EAX) + ADD(tgtReg, 1) + POP(ESI) + cmn; break;
			}
			funcEnd = Exe.FindHex(prefix + ms);
		}
		if (funcEnd < 0)
			throw Error("CustomSlashCommand: GetNoParamTalkType suffix not found");

		const suffixStart = funcEnd + prefix.byteCount();
		const afterHookVir = Exe.Phy2Vir(suffixStart + movPos + 5, CODE);

		if (movPos > 0)
		{
			const pPat = (ROC.HasFP ? FP_START : '') + SUB(ESP, 8);
			const prologue = Exe.FindLastHex(pPat, funcEnd, funcEnd - 0x500);
			if (prologue >= 0)
			{
				const bw = Exe.FindHex(' 89 4D 08 8B 09', prologue, funcEnd);
				const br = Exe.FindHex(' 8B 55 08 83 C8 FF', prologue, funcEnd);
				if (bw >= 0 && br >= 0)
				{
					Exe.SetInt8(prologue + pPat.byteCount() - 1, 0x0C);
					Exe.SetInt8(bw + 2, 0xF4);
					Exe.SetInt8(br + 2, 0xF4);
				}
			}
		}

		const commands = registry.map(entry =>
		{
			return {
				command: entry.command,
				targetVir: entry.targetVir,
				optionId: entry.optionId
			};
		});
		if (typeof PatchDiagnostics !== "undefined" &&
		    typeof PatchDiagnostics.add === "function")
			PatchDiagnostics.add('CustomSlashCommand.refresh.commands', {
				owner: currentOwner,
				commands
			});

		const caveSize = 0x80 + commands.reduce(
			(total, entry) => total + (entry.command.length + 1) * 12 + 80,
			0
		);
		const [cavePhy, caveVir] = Exe.Allocate(caveSize, 0x10);
		const b = [];
		const u32 = value =>
		{
			const v = value >>> 0;
			b.push(v & 0xFF, (v >>> 8) & 0xFF, (v >>> 16) & 0xFF, (v >>> 24) & 0xFF);
		};
		const off = () => b.length;
		const hexBytes = hex =>
		{
			if (!hex)
				return;
			for (const part of hex.trim().split(/ +/))
			{
				if (part.length === 2)
					b.push(parseInt(part, 16));
				else
					for (let i = 0; i < part.length; i += 2)
						b.push(parseInt(part.substring(i, i + 2), 16));
			}
		};
		const emitCmpJne = (disp, imm) =>
		{
			if (disp === 0)
				b.push(0x80, 0x3F, imm & 0xFF);
			else
				b.push(0x80, 0x7F, disp & 0xFF, imm & 0xFF);
			b.push(0x0F, 0x85);
			const rel = off();
			u32(0);
			return rel;
		};
		const emitJmp = () =>
		{
			b.push(0xE9);
			const rel = off();
			u32(0);
			return rel;
		};
		const emitMovEaxImm = value =>
		{
			b.push(0xB8);
			u32(value);
		};
		const patchRel = (at, targetVir) =>
		{
			const rel = targetVir - (caveVir + at + 4);
			b[at] = rel & 0xFF;
			b[at + 1] = (rel >>> 8) & 0xFF;
			b[at + 2] = (rel >>> 16) & 0xFF;
			b[at + 3] = (rel >>> 24) & 0xFF;
		};
		const settingsLookupReturnVir =
			Exe.BuildDate === 20250716 ? 0x0068FCE8 : 0;

		b.push(0x8B, 0x7D, 0x08); // MOV EDI,[EBP+8]
		let previousMisses = [];

		for (const entry of commands)
		{
			const commandStart = caveVir + off();
			for (const miss of previousMisses)
				patchRel(miss, commandStart);

			previousMisses = [];
			for (let i = 0; i < entry.command.length; ++i)
				previousMisses.push(emitCmpJne(i, entry.command.charCodeAt(i)));
			previousMisses.push(emitCmpJne(entry.command.length, 0));

			if (settingsLookupReturnVir)
			{
				b.push(0x8B, 0x45, 0x00); // MOV EAX,[EBP] ; caller frame
				b.push(0x81, 0x78, 0x04); // CMP DWORD PTR [EAX+4],imm32
				u32(settingsLookupReturnVir);
				b.push(0x0F, 0x85); // JNE runtime command path
				const runtimeRel = off();
				u32(0);

				hexBytes(extraPops);
				emitMovEaxImm(entry.optionId !== null ? entry.optionId : 3);
				const optionOut = emitJmp();
				patchRel(optionOut, afterHookVir);
				patchRel(runtimeRel, caveVir + off());
			}

			b.push(0xE8);                     // CALL static cave
			const callRel = off();
			u32(0);
			patchRel(callRel, entry.targetVir);
			hexBytes(extraPops);
			b.push(0x33, 0xC0); // XOR EAX,EAX
			const out = emitJmp();
			patchRel(out, afterHookVir);
		}

		const notMatchedVir = caveVir + off();
		for (const miss of previousMisses)
			patchRel(miss, notMatchedVir);

		hexBytes(extraPops);
		emitMovEaxImm(3); // TT_UNKNOWN
		const notMatchedOut = emitJmp();
		patchRel(notMatchedOut, afterHookVir);

		let hex = '';
		for (const value of b)
			hex += ' ' + (value < 0x10 ? '0' : '') + value.toString(16).toUpperCase();

		Exe.SetHex(cavePhy, hex);
		Exe.SetJMP(suffixStart, caveVir, 0);

		return true;
	}
	finally
	{
		Exe.EndTag();
		Exe.ActivePatch = callerPatch;
	}
};
