/**************************************************************************\
*                                                                          *
*   Standalone stock-menu launcher for Banquet Item Collection.           *
*                                                                          *
*   Description   : Adds an independent native UIButton synchronized to   *
*                   the stock 2025-07-16 UIMenuIconWnd. It consumes the    *
*                   ItemCollectionUI.MenuButton.v1 bridge and requires no  *
*                   RO Global UI or Auto Hunt patch.                      *
*                                                                          *
\**************************************************************************/

const ItemCollectionStockMenuButtonStatic = {
	BuildDate: 20250716,
	MenuDrawVtable: 0x01028200,
	MenuDrawOriginal: 0x00814150,
	MenuVisibilityVtable: 0x010281E8,
	MenuVisibilityOriginal: 0x005AAD80,
	MenuOnCreateVtable: 0x010281EC,
	MenuOnCreateOriginal: 0x00812FB0,
	MenuExpandedFlag: 0x0160227C,
	ButtonConstructor: 0x008172B0,
	ButtonVtable: 0x01029820,
	ButtonVtableEntries: 54,
	ButtonDeletingDestructor: 0x0081A5A0,
	ButtonDraw: 0x00823E10,
	ButtonSetImage: 0x0082DAC0,
	WindowSetImageSize: 0x00A1CB70,
	WindowSetPosition: 0x00874AF0,
	WindowId: 0x3F4,
	NewWidth: 45,
	NewHeight: 41,
	ClassicWidth: 32,
	ClassicHeight: 34,
	Gap: 4,
	ScreenMargin: 10
};

ItemCollectionStockMenuButtonStatic.allocateCode = function(assembler)
{
	return ItemCollectionUIStatic.allocateCode(assembler);
};

ItemCollectionStockMenuButtonStatic.buildDestructor = function(stateVir)
{
	const s = ItemCollectionStockMenuButtonStatic;
	const a = ItemCollectionUIStatic.asm();
	a.emit(0x3B, 0x0D); a.dword(stateVir);
	a.jcc(0x85, "native");
	a.emit(0xC7, 0x05); a.dword(stateVir); a.dword(0);
	a.label("native");
	a.jmp(s.ButtonDeletingDestructor);
	return a;
};

ItemCollectionStockMenuButtonStatic.buildMouseUp = function(requestVir)
{
	const a = ItemCollectionUIStatic.asm();
	a.emit(0x55, 0x8B, 0xEC);
	a.call(requestVir);
	a.emit(0x33, 0xC0, 0x8B, 0xE5, 0x5D, 0xC2, 0x08, 0x00);
	return a;
};

ItemCollectionStockMenuButtonStatic.buildMouseDown = function()
{
	const a = ItemCollectionUIStatic.asm();
	a.emit(0xC2, 0x08, 0x00);
	return a;
};

ItemCollectionStockMenuButtonStatic.buildHover = function()
{
	const a = ItemCollectionUIStatic.asm();
	a.emit(0x33, 0xC0, 0xC2, 0x08, 0x00);
	return a;
};

ItemCollectionStockMenuButtonStatic.cloneButtonVtable = function(
	mouseUpVir, hoverVir, destructorVir, mouseDownVir
)
{
	const s = ItemCollectionStockMenuButtonStatic;
	const sourcePhy = Exe.Vir2Phy(s.ButtonVtable);
	if (sourcePhy < 0)
		throw Error("ItemCollectionStockMenuButton: UIButton vtable is not mapped");
	const bytes = [];
	for (let index = 0; index < s.ButtonVtableEntries; ++index)
	{
		let value = Exe.GetUint32(sourcePhy + index * 4);
		if (index === 0)
			value = destructorVir;
		else if (index === 20)
			value = s.ButtonDraw;
		else if (index === 25)
			value = mouseDownVir;
		else if (index === 28)
			value = hoverVir;
		else if (index === 31)
			value = mouseUpVir;
		for (let shift = 0; shift < 32; shift += 8)
			bytes.push((value >>> shift) & 0xFF);
	}
	return ItemCollectionUIStatic.allocateBytes(bytes, 4);
};

ItemCollectionStockMenuButtonStatic.buildEnsure = function(
	stateVir, vtableVir, imagePaths
)
{
	const s = ItemCollectionStockMenuButtonStatic;
	const c = ItemCollectionUIStatic;
	const a = c.asm();
	a.emit(0x55, 0x8B, 0xEC, 0x53, 0x56, 0x57, 0x8B, 0xF1);
	a.emit(0x8B, 0x3D); a.dword(stateVir);
	a.emit(0x85, 0xFF);
	a.jcc(0x84, "create");
	a.emit(0x81, 0x3F); a.dword(vtableVir);
	a.jcc(0x84, "done");
	a.label("create");
	c.pushImm(a, 0x120);
	a.call(c.OperatorNew);
	a.emit(0x83, 0xC4, 0x04, 0x85, 0xC0);
	a.jcc(0x84, "done");
	a.emit(0x8B, 0xF8, 0x8B, 0xCF);
	a.call(s.ButtonConstructor);
	a.emit(0xC7, 0x07); a.dword(vtableVir);
	for (let index = 0; index < 3; ++index)
	{
		c.pushImm(a, 1);
		c.pushImm(a, index);
		c.pushImm(a, imagePaths[index]);
		a.emit(0x8B, 0xCF);
		a.call(s.ButtonSetImage);
	}
	a.emit(0xFF, 0xB7); a.dword(0xB8);
	a.emit(0xFF, 0xB7); a.dword(0xB4);
	a.emit(0x8B, 0xCF);
	a.call(s.WindowSetImageSize);
	a.emit(0xC7, 0x47, 0x2C); a.dword(s.WindowId);
	a.emit(0x57, 0xB9); a.dword(c.WindowManager);
	a.call(c.WindowAddTopLevelFront);
	a.emit(0x89, 0x3D); a.dword(stateVir);
	a.label("done");
	a.emit(0x5F, 0x5E, 0x5B, 0x8B, 0xE5, 0x5D, 0xC3);
	return a;
};

ItemCollectionStockMenuButtonStatic.buildSync = function(
	stateVir, width, height
)
{
	const s = ItemCollectionStockMenuButtonStatic;
	const c = ItemCollectionUIStatic;
	const a = c.asm();
	a.emit(0x55, 0x8B, 0xEC, 0x53, 0x56, 0x57, 0x8B, 0xF1);
	a.emit(0x8B, 0x3D); a.dword(stateVir);
	a.emit(0x85, 0xFF); a.jcc(0x84, "done");
	a.emit(0x6A, 0x00, 0x8B, 0x17, 0x8B, 0xCF);
	a.emit(0xFF, 0x92); a.dword(0xD4);                 // hide first
	a.emit(0x83, 0x7E, 0x28, 0x00); a.jcc(0x84, "done");
	a.emit(0x80, 0x3D); a.dword(s.MenuExpandedFlag); a.emit(0x00);
	a.jcc(0x84, "done");

	// X = menu X + margin, bounded to the renderer.
	a.emit(0x8B, 0x5E, 0x1C, 0x83, 0xC3, s.ScreenMargin);
	a.emit(0xA1); a.dword(c.Renderer);
	a.emit(0x85, 0xC0); a.jcc(0x84, "x_ready");
	a.emit(0x8B, 0x40, c.RendererWidthOffset);
	a.emit(0x2D); a.dword(width + s.ScreenMargin);
	a.emit(0x3B, 0xD8); a.jcc(0x8E, "x_ready");
	a.emit(0x8B, 0xD8);
	a.label("x_ready");
	a.emit(0x83, 0xFB, s.ScreenMargin); a.jcc(0x8D, "x_store");
	a.emit(0xBB); a.dword(s.ScreenMargin);
	a.label("x_store");

	// Prefer below the stock menu; move above it if the screen bottom clips.
	a.emit(0x8B, 0x56, 0x20, 0x03, 0x56, 0x18);
	a.emit(0x83, 0xC2, s.Gap);
	a.emit(0xA1); a.dword(c.Renderer);
	a.emit(0x85, 0xC0); a.jcc(0x84, "position");
	a.emit(0x8B, 0x40, c.RendererHeightOffset);
	a.emit(0x2D); a.dword(height + s.ScreenMargin);
	a.emit(0x3B, 0xD0); a.jcc(0x8E, "position");
	a.emit(0x8B, 0x56, 0x20, 0x81, 0xEA); a.dword(height + s.Gap);
	a.label("position");
	a.emit(0x52, 0x53, 0x8B, 0xCF);
	a.call(s.WindowSetPosition);
	a.emit(0x6A, 0x01, 0x8B, 0x17, 0x8B, 0xCF);
	a.emit(0xFF, 0x92); a.dword(0xD4);
	a.label("done");
	a.emit(0x5F, 0x5E, 0x5B, 0x8B, 0xE5, 0x5D, 0xC3);
	return a;
};

ItemCollectionStockMenuButtonStatic.buildDrawWrapper = function(
	ensureVir, syncVir
)
{
	const s = ItemCollectionStockMenuButtonStatic;
	const a = ItemCollectionUIStatic.asm();
	a.emit(0x55, 0x8B, 0xEC, 0x53, 0x56, 0x8B, 0xF1);
	a.emit(0x8B, 0xCE); a.call(ensureVir);
	a.emit(0x8B, 0xCE); a.call(syncVir);
	a.emit(0x8B, 0xCE); a.call(s.MenuDrawOriginal);
	a.emit(0x5E, 0x5B, 0x8B, 0xE5, 0x5D, 0xC3);
	return a;
};

ItemCollectionStockMenuButtonStatic.buildOnCreateWrapper = function(
	ensureVir, syncVir
)
{
	const s = ItemCollectionStockMenuButtonStatic;
	const a = ItemCollectionUIStatic.asm();
	a.emit(0x55, 0x8B, 0xEC, 0x53, 0x56, 0x8B, 0xF1);
	a.emit(0xFF, 0x75, 0x0C, 0xFF, 0x75, 0x08, 0x8B, 0xCE);
	a.call(s.MenuOnCreateOriginal);
	a.emit(0x8B, 0xD8);
	a.emit(0x8B, 0xCE); a.call(ensureVir);
	a.emit(0x8B, 0xCE); a.call(syncVir);
	a.emit(0x8B, 0xC3, 0x5E, 0x5B, 0x8B, 0xE5, 0x5D, 0xC2, 0x08, 0x00);
	return a;
};

ItemCollectionStockMenuButtonStatic.buildVisibilityWrapper = function(
	stateVir, syncVir
)
{
	const s = ItemCollectionStockMenuButtonStatic;
	const a = ItemCollectionUIStatic.asm();
	a.emit(0x55, 0x8B, 0xEC, 0x53, 0x56, 0x8B, 0xF1);
	a.emit(0xFF, 0x75, 0x08, 0x8B, 0xCE);
	a.call(s.MenuVisibilityOriginal);
	a.emit(0x8B, 0xD8);
	a.emit(0x83, 0x7D, 0x08, 0x00); a.jcc(0x84, "hide");
	a.emit(0x8B, 0xCE); a.call(syncVir);
	a.jmp("done");
	a.label("hide");
	a.emit(0x8B, 0x0D); a.dword(stateVir);
	a.emit(0x85, 0xC9); a.jcc(0x84, "done");
	a.emit(0x6A, 0x00, 0x8B, 0x11, 0xFF, 0x92); a.dword(0xD4);
	a.label("done");
	a.emit(0x8B, 0xC3, 0x5E, 0x5B, 0x8B, 0xE5, 0x5D, 0xC2, 0x04, 0x00);
	return a;
};

ItemCollectionStockMenuButton = function(_)
{
	const s = ItemCollectionStockMenuButtonStatic;
	if (Exe.BuildDate !== s.BuildDate)
		throw Error("ItemCollectionStockMenuButton supports only 2025-07-16");
	if (typeof ItemCollectionUIStatic === "undefined")
		throw Error("ItemCollectionStockMenuButton: ItemCollectionUI must run first");
	const c = ItemCollectionUIStatic;
	const bridge = CACHE.get("ItemCollectionUI.MenuButton.v1");
	if (!bridge || !Number.isInteger(bridge.requestVir))
		throw Error("ItemCollectionStockMenuButton: Item Collection bridge missing");

	let style = "New UI";
	if (!Warp.TestMode)
	{
		style = Exe.GetUserInput(
			"$itemCollectionStandaloneStyle", D_Choice,
			"Item Collection Launcher",
			"Select the stock menu icon style.",
			"New UI",
			{choices: ["New UI", "Classic"], saveDefault: true}
		);
	}
	const classic = style === "Classic";
	const width = classic ? s.ClassicWidth : s.NewWidth;
	const height = classic ? s.ClassicHeight : s.NewHeight;
	const names = classic
		? [
			"bt_itemcollection_old_normal.bmp",
			"bt_itemcollection_old_mouseon.bmp",
			"bt_itemcollection_old_pressed.bmp"
		]
		: [
			"bt_itemcollection_normal.bmp",
			"bt_itemcollection_mouseon.bmp",
			"bt_itemcollection_pressed.bmp"
		];
	const imagePaths = names.map(name => c.allocateString(
		c.buildResourcePath("uirenewal\\menuicon\\" + name)
	).vir);
	const state = c.allocateBytes([0, 0, 0, 0], 4);
	const destructor = s.allocateCode(s.buildDestructor(state.vir));
	const mouseUp = s.allocateCode(s.buildMouseUp(bridge.requestVir));
	const mouseDown = s.allocateCode(s.buildMouseDown());
	const hover = s.allocateCode(s.buildHover());
	const vtable = s.cloneButtonVtable(
		mouseUp.vir, hover.vir, destructor.vir, mouseDown.vir
	);
	const ensure = s.allocateCode(
		s.buildEnsure(state.vir, vtable.vir, imagePaths)
	);
	const sync = s.allocateCode(s.buildSync(state.vir, width, height));
	const draw = s.allocateCode(s.buildDrawWrapper(ensure.vir, sync.vir));
	const onCreate = s.allocateCode(s.buildOnCreateWrapper(ensure.vir, sync.vir));
	const visibility = s.allocateCode(
		s.buildVisibilityWrapper(state.vir, sync.vir)
	);

	const patches = [
		[s.MenuDrawVtable, s.MenuDrawOriginal, draw.vir],
		[s.MenuOnCreateVtable, s.MenuOnCreateOriginal, onCreate.vir],
		[s.MenuVisibilityVtable, s.MenuVisibilityOriginal, visibility.vir]
	];
	for (const [entryVir, expected, replacement] of patches)
	{
		const entryPhy = Exe.Vir2Phy(entryVir);
		if (entryPhy < 0 || Exe.GetUint32(entryPhy) !== expected)
			throw Error(`ItemCollectionStockMenuButton: vtable changed at ${entryVir.toHex(true)}`);
		Exe.SetUint32(entryPhy, replacement);
	}
	return true;
};

ItemCollectionStockMenuButton.validate = function()
{
	return Exe.BuildDate === ItemCollectionStockMenuButtonStatic.BuildDate &&
		typeof ItemCollectionUIStatic !== "undefined";
};
