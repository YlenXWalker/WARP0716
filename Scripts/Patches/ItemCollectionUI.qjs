ItemCollectionUIStatic.onApplied = function()
{
	if (Warp.TestMode || !Exe.GetSavedInput("$copyItemCollectionAssets"))
		return;
	const c = ItemCollectionUIStatic;
	const source = Warp.Path + c.AssetPath;
	const clientDir = System.DirPath(Warp.TgtExe);
	const target = clientDir + "/data/texture/" + c.uiPrefix() + "/" + c.TargetLeaf;
	if (!System.MkDir(target))
		throw Error(`ItemCollectionUI: unable to create ${target}`);
	for (const directory of c.AssetDirectories)
	{
		if (!System.MkDir(target + "/" + directory))
			throw Error(`ItemCollectionUI: unable to create ${directory}`);
	}
	for (const file of c.Assets)
	{
		if (!System.Copy(source + "/" + file, target + "/" + file, true))
			throw Error(`ItemCollectionUI: unable to copy ${file}`);
	}
	const menuTarget = clientDir + "/data/texture/" + c.uiPrefix() +
		"/uirenewal/menuicon";
	if (!System.MkDir(menuTarget))
		throw Error(`ItemCollectionUI: unable to create ${menuTarget}`);
	for (const file of c.MenuAssets)
	{
		if (!System.Copy(
			source + "/menuicon/" + file,
			menuTarget + "/" + file,
			true
		))
			throw Error(`ItemCollectionUI: unable to copy menu icon ${file}`);
	}
};

ItemCollectionUI = function(_)
{
	const c = ItemCollectionUIStatic;
	if (Exe.BuildDate !== c.BuildDate)
		throw Error("ItemCollectionUI supports only the 2025-07-16 client");
	if (typeof CustomSlashCommand === "undefined" ||
		typeof CustomSlashCommand.register !== "function")
		throw Error("ItemCollectionUI: CustomSlashCommand helper unavailable");

	$$(_, 1, "Verify the native UIFrameWnd and item-resource ABI");
	c.verifyNativeContracts();

	$$(_, 2, "Build Item Collection resource paths and runtime labels");
	const resource = relative => c.buildResourcePath(
		c.TargetLeaf + "\\" + relative
	);
	const paths = {
		title: resource("chrome\\title_bar_760.bmp"),
		body: resource("chrome\\bg_collection.bmp"),
		loading: resource("chrome\\loading.bmp"),
		icon: resource("icons\\icon_collection.bmp"),
		badgeLocked: resource("icons\\badge_locked.bmp"),
		badgeComplete: resource("icons\\badge_complete.bmp"),
		fallback: resource("reused\\artwork\\fallback_question_mark.bmp"),
		searchField: resource("reused\\search\\searchbar_bg.bmp"),
		searchNormal: resource("reused\\search\\btn_searchbar_normal.bmp"),
		searchOver: resource("reused\\search\\btn_searchbar__mouseon.bmp"),
		searchPress: resource("reused\\search\\btn_searchbar_pressed.bmp"),
		zeny: resource("reused\\currency\\icon_zeny.bmp"),
		close: {
			normal: resource("reused\\close\\btn_close_normal.bmp"),
			over: resource("reused\\close\\btn_close_mouseon.bmp"),
			press: resource("reused\\close\\btn_close_pressed.bmp")
		},
		minus: {
			normal: resource("reused\\steppers\\btn_minus_normal.bmp"),
			over: resource("reused\\steppers\\btn_minus_over.bmp"),
			press: resource("reused\\steppers\\btn_minus_press.bmp")
		},
		plus: {
			normal: resource("reused\\steppers\\btn_plus_normal.bmp"),
			over: resource("reused\\steppers\\btn_plus_over.bmp"),
			press: resource("reused\\steppers\\btn_plus_press.bmp")
		},
		scroll: {
			up: resource("reused\\scrollbar\\btn_scroll_arrow_up.bmp"),
			down: resource("reused\\scrollbar\\btn_scroll_arrow_down.bmp"),
			thumbTop: resource("reused\\scrollbar\\scrollbar_thumb_out_top.bmp"),
			thumbMid: resource("reused\\scrollbar\\scrollbar_thumb_out_mid.bmp"),
			thumbBottom: resource("reused\\scrollbar\\scrollbar_thumb_out_btm.bmp")
		},
		buttons: {},
		artFormat: c.buildResourcePath("collection\\%s.bmp"),
		itemArtFormat: c.buildResourcePath("item\\%s.bmp")
	};
	for (const state of ["out", "over", "press", "disable"])
	{
		paths.buttons[state] = ["left", "mid", "right"].map(part =>
			resource(`reused\\buttons\\generic\\btn_${state}_${part}.bmp`)
		);
	}

	const text = value => c.allocateString(value);
	const strings = {
		title: text("ITEM COLLECTION"),
		collected: text("Collected"),
		summaryFormat: text("Collected %u / %u"),
		searchPlaceholder: text("Search item name or ID"),
		tabs: ["Items", "Combo Collections", "Total Bonuses"].map(text),
		categories: [
			"All Items", "Cards", "Weapons", "Armor", "Shields",
			"Headgear", "Garments", "Shoes", "Accessories",
			"Consumables", "Etc", "Ammo", "Pet Items", "Shadow Gear",
			"Cash Items"
		].map(text),
		cardFilters: ["All", "Missing", "Partial", "Completed"].map(text),
		comboFilters: ["All", "Incomplete", "Ready", "Active"].map(text),
		countFormat: text("%u / %u"),
		uintFormat: text("%u"),
		itemIdFormat: text("Item ID %u"),
		depositedFormat: text("%u / %u deposited"),
		feeFormat: text("Deposit %s / Withdraw %s Zeny"),
		collectionBonus: text("Collection Bonus"),
		requiredCards: text("Required Cards"),
		comboBonus: text("Combo Bonus"),
		totalBonusHeading: text("Active Collection Bonuses"),
		totalBonusInfo: text("All values are authoritative"),
		totalBonusInfo2: text("and account-wide."),
		deposit: text("Deposit"),
		depositAll: text("Deposit All"),
		withdraw: text("Withdraw"),
		activateBonus: text("Activate Bonus"),
		deactivateBonus: text("Deactivate Bonus"),
		cardsRemain: text("Cards remain in your collection."),
		plusOneMore: text("+1 more"),
		active: text("Active"),
		ready: text("Ready"),
		incomplete: text("Incomplete"),
		accountWide: text("Item Collection is account-wide."),
		zeny: text("Zeny"),
		saving: text("Saving collection change..."),
		mutationResults: [
			"",
			"",
			"Invalid collection request.",
			"Item Collection is disabled.",
			"Collection changed; please retry.",
			"Collection target was not found.",
			"Storage is busy; please retry.",
			"No eligible card is in inventory.",
			"Storage rejected the transfer.",
			"Withdrawal is disabled.",
			"Combo requirements are not met.",
			"Storage save failed.",
			"Collection target is ambiguous.",
			"Duplicate request was ignored.",
			"Unsupported collection action."
		].map(text),
		truncated: text("Some collection entries were truncated by the server.")
	};

	const state = c.allocateBytes(new Array(c.StateSize).fill(0), 4);
	const payload = c.allocateBytes(new Array(c.PayloadSize).fill(0), 4);
	const artPath = c.allocateBytes(new Array(256).fill(0), 4);
	const countText = c.allocateBytes(new Array(32).fill(0), 4);
	const detailText = c.allocateBytes(new Array(128).fill(0), 4);
	const moneyText1 = c.allocateBytes(new Array(c.MoneyBufferSize).fill(0), 4);
	const moneyText2 = c.allocateBytes(new Array(c.MoneyBufferSize).fill(0), 4);
	const searchText = c.allocateBytes(new Array(c.SearchTextSize).fill(0), 4);
	Exe.SetUint32(state.phy + c.StateQuantity, 1);
	Exe.SetUint32(state.phy + c.StateThumbY, 128);

	$$(_, 3, "Install COUI v1 request and shared snapshot transport");
	const packetRefs = c.resolvePacketRefs();
	const sender = c.allocateCode(c.buildRequestSender(
		state.vir, packetRefs, searchText.vir
	));
	const receiver = c.allocateCode(c.buildSnapshotReceiver(state.vir, payload.vir));
	const route = c.ensureSharedPacketRoute(_, receiver.vir);

	$$(_, 4, "Create the native Item Collection UIFrameWnd");
	const fillRect = c.allocateCode(c.buildFillRect());
	const colorKeyBlit = c.allocateCode(c.buildColorKeyBlit());
	c.ColorKeyBlitVir = colorKeyBlit.vir;
	const drawPath = c.allocateCode(c.buildDynamicPathDraw(colorKeyBlit.vir));
	const nineSlice = c.allocateCode(c.buildNineSliceButton(drawPath.vir));
	const itemResolver = c.allocateCode(c.buildItemResourceResolver());
	const commaFormatter = c.allocateCode(c.buildFormatU32Commas());
	const timeGetTimeIat = Exe.FindFunc("timeGetTime", "winmm.dll");
	if (timeGetTimeIat < 0)
		throw Error("ItemCollectionUI: timeGetTime IAT missing");
	const searchInput = c.allocateCode(c.buildSearchNativeInput(
		state.vir, searchText.vir, sender.vir, timeGetTimeIat
	));
	const draw = c.allocateCode(c.buildDraw(
		state.vir, payload.vir, paths, fillRect.vir, nineSlice.vir,
		strings, itemResolver.vir, artPath.vir, countText.vir,
		detailText.vir, drawPath.vir, commaFormatter.vir,
		moneyText1.vir, moneyText2.vir, searchInput.vir, searchText.vir
	));
	const mouseDown = c.allocateCode(c.buildMouseDown(
		state.vir, payload.vir, sender.vir
	));
	const mouseMove = c.allocateCode(c.buildMouseMove(state.vir));
	const mouseUp = c.allocateCode(c.buildMouseUp(
		state.vir, payload.vir, sender.vir
	));
	const mouseWheel = c.allocateCode(c.buildMouseWheel(state.vir, sender.vir));
	const destructor = c.allocateCode(c.buildDestructor(state.vir));
	const vtable = c.cloneFrameVtable(
		draw.vir, mouseDown.vir, mouseMove.vir, mouseUp.vir,
		mouseWheel.vir, destructor.vir
	);
	const toggle = c.allocateCode(c.buildToggle(state.vir, vtable.vir, sender.vir));
	const menuButtonVisible = c.allocateBytes([1, 0, 0, 0], 4);

	CustomSlashCommand.register(_ + ".SlashCommand", {
		command: "/itemcollection",
		targetVir: toggle.vir
	});
	CACHE.put("ItemCollectionUI.MenuButton.v1", {
		toggleVir: toggle.vir,
		requestVir: toggle.vir,
		visibleVir: menuButtonVisible.vir,
		visiblePhy: menuButtonVisible.phy,
		label: "Item Collection"
	});

	if (!Warp.TestMode)
		Exe.GetUserInput(
			"$copyItemCollectionAssets",
			D_Bool,
			"Copy Item Collection UI Assets",
			"Copy the approved Item Collection BMP assets into the target client data folder?",
			true,
			{saveDefault: true}
		);

	if (typeof PatchDiagnostics !== "undefined" &&
		typeof PatchDiagnostics.add === "function")
	{
		PatchDiagnostics.add("ItemCollectionUI.QjsOnly", {
			buildDate: Exe.BuildDate,
			opener: "/itemcollection",
			nativeHost: "UIFrameWnd",
			windowSize: [c.WindowWidth, c.WindowHeight],
			clientPacketId: c.ClientPacketId,
			serverPacketId: c.ServerPacketId,
			magic: "COUI",
			version: c.ProtocolVersion,
			stateVir: state.vir,
			payloadVir: payload.vir,
			senderVir: sender.vir,
			receiverVir: receiver.vir,
			routerVir: route.routerVir,
			couiHandlerCellVir: route.couiHandlerCellVir,
			toggleVir: toggle.vir,
			search: "native-ui-edit-ctrl-debounce",
			searchTextVir: searchText.vir,
			searchInputVir: searchInput.vir,
			searchEditStateVir: state.vir + c.StateSearchEdit,
			externalModules: 0
		});
	}
	$$(_, 5, "Item Collection UI and server-authoritative actions enabled");
	return true;
};

ItemCollectionUI.onApplied = ItemCollectionUIStatic.onApplied;

ItemCollectionUI.validate = function()
{
	if (Exe.BuildDate !== ItemCollectionUIStatic.BuildDate)
		return false;
	try
	{
		ItemCollectionUIStatic.verifyNativeContracts();
		return true;
	}
	catch (_)
	{
		return false;
	}
};
