+ItemCollectionStockMenuButtonStatic.cloneButtonVtable = function(
+	mouseUpVir, hoverVir, destructorVir, mouseDownVir
+)
+{
+	const s = ItemCollectionStockMenuButtonStatic;
+	const sourcePhy = Exe.Vir2Phy(s.ButtonVtable);
+	if (sourcePhy < 0)
+		throw Error("ItemCollectionStockMenuButton: UIButton vtable is not mapped");
+	const bytes = [];
+	for (let index = 0; index < s.ButtonVtableEntries; ++index)
+	{
+		let value = Exe.GetUint32(sourcePhy + index * 4);
+		if (index === 0)
+			value = destructorVir;
+		else if (index === 20)
+			value = s.ButtonDraw;
+		else if (index === 25)
+			value = mouseDownVir;
+		else if (index === 28)
+			value = hoverVir;
+		else if (index === 31)
+			value = mouseUpVir;
+		for (let shift = 0; shift < 32; shift += 8)
+			bytes.push((value >>> shift) & 0xFF);
+	}
+	return ItemCollectionUIStatic.allocateBytes(bytes, 4);
+};
+
+ItemCollectionStockMenuButtonStatic.buildEnsure = function(
+	stateVir, vtableVir, imagePaths
+)
+{
+	const s = ItemCollectionStockMenuButtonStatic;
+	const c = ItemCollectionUIStatic;
+	const a = c.asm();
+	a.emit(0x55, 0x8B, 0xEC, 0x53, 0x56, 0x57, 0x8B, 0xF1);
+	a.emit(0x8B, 0x3D); a.dword(stateVir);
+	a.emit(0x85, 0xFF);
+	a.jcc(0x84, "create");
+	a.emit(0x81, 0x3F); a.dword(vtableVir);
+	a.jcc(0x84, "done");
+	a.label("create");
+	c.pushImm(a, 0x120);
+	a.call(c.OperatorNew);
+	a.emit(0x83, 0xC4, 0x04, 0x85, 0xC0);
+	a.jcc(0x84, "done");
+	a.emit(0x8B, 0xF8, 0x8B, 0xCF);
+	a.call(s.ButtonConstructor);
+	a.emit(0xC7, 0x07); a.dword(vtableVir);
+	for (let index = 0; index < 3; ++index)
+	{
+		c.pushImm(a, 1);
+		c.pushImm(a, index);
+		c.pushImm(a, imagePaths[index]);
+		a.emit(0x8B, 0xCF);
+		a.call(s.ButtonSetImage);
+	}
+	a.emit(0xFF, 0xB7); a.dword(0xB8);
+	a.emit(0xFF, 0xB7); a.dword(0xB4);
+	a.emit(0x8B, 0xCF);
+	a.call(s.WindowSetImageSize);
+	a.emit(0xC7, 0x47, 0x2C); a.dword(s.WindowId);
+	a.emit(0x57, 0xB9); a.dword(c.WindowManager);
+	a.call(c.WindowAddTopLevelFront);
+	a.emit(0x89, 0x3D); a.dword(stateVir);
+	a.label("done");
+	a.emit(0x5F, 0x5E, 0x5B, 0x8B, 0xE5, 0x5D, 0xC3);
+	return a;
+};
+
+ItemCollectionStockMenuButtonStatic.buildSync = function(
+	stateVir, width, height
+)
+{
+	const s = ItemCollectionStockMenuButtonStatic;
+	const c = ItemCollectionUIStatic;
+	const a = c.asm();
+	a.emit(0x55, 0x8B, 0xEC, 0x53, 0x56, 0x57, 0x8B, 0xF1);
+	a.emit(0x8B, 0x3D); a.dword(stateVir);
+	a.emit(0x85, 0xFF); a.jcc(0x84, "done");
+	a.emit(0x6A, 0x00, 0x8B, 0x17, 0x8B, 0xCF);
+	a.emit(0xFF, 0x92); a.dword(0xD4);                 // hide first
+	a.emit(0x83, 0x7E, 0x28, 0x00); a.jcc(0x84, "done");
+	a.emit(0x80, 0x3D); a.dword(s.MenuExpandedFlag); a.emit(0x00);
+	a.jcc(0x84, "done");
+
+	// X = menu X + margin, bounded to the renderer.
+	a.emit(0x8B, 0x5E, 0x1C, 0x83, 0xC3, s.ScreenMargin);
+	a.emit(0xA1); a.dword(c.Renderer);
+	a.emit(0x85, 0xC0); a.jcc(0x84, "x_ready");
+	a.emit(0x8B, 0x40, c.RendererWidthOffset);
+	a.emit(0x2D); a.dword(width + s.ScreenMargin);
+	a.emit(0x3B, 0xD8); a.jcc(0x8E, "x_ready");
+	a.emit(0x8B, 0xD8);
+	a.label("x_ready");
+	a.emit(0x83, 0xFB, s.ScreenMargin); a.jcc(0x8D, "x_store");
+	a.emit(0xBB); a.dword(s.ScreenMargin);
+	a.label("x_store");
+
+	// Prefer below the stock menu; move above it if the screen bottom clips.
+	a.emit(0x8B, 0x56, 0x20, 0x03, 0x56, 0x18);
+	a.emit(0x83, 0xC2, s.Gap);
+	a.emit(0xA1); a.dword(c.Renderer);
+	a.emit(0x85, 0xC0); a.jcc(0x84, "position");
+	a.emit(0x8B, 0x40, c.RendererHeightOffset);
+	a.emit(0x2D); a.dword(height + s.ScreenMargin);
+	a.emit(0x3B, 0xD0); a.jcc(0x8E, "position");
+	a.emit(0x8B, 0x56, 0x20, 0x81, 0xEA); a.dword(height + s.Gap);
+	a.label("position");
+	a.emit(0x52, 0x53, 0x8B, 0xCF);
+	a.call(s.WindowSetPosition);
+	a.emit(0x6A, 0x01, 0x8B, 0x17, 0x8B, 0xCF);
+	a.emit(0xFF, 0x92); a.dword(0xD4);
+	a.label("done");
+	a.emit(0x5F, 0x5E, 0x5B, 0x8B, 0xE5, 0x5D, 0xC3);
+	return a;
+};
