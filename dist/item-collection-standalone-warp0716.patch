+	a.emit(0x83, 0x7D, 0x08, 0x00); a.jcc(0x84, "hide");
+	a.emit(0x8B, 0xCE); a.call(syncVir);
+	a.jmp("done");
+	a.label("hide");
+	a.emit(0x8B, 0x0D); a.dword(stateVir);
+	a.emit(0x85, 0xC9); a.jcc(0x84, "done");
+	a.emit(0x6A, 0x00, 0x8B, 0x11, 0xFF, 0x92); a.dword(0xD4);
