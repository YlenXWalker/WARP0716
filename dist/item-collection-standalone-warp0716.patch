+ItemCollectionUIStatic.emitLoadSurface = function(a, pathVir, missingLabel)
+{
+	const c = ItemCollectionUIStatic;
+	a.call(c.GetTexMgr);
+	a.emit(0x8B, 0xD8, 0x85, 0xDB); a.jcc(0x84, missingLabel);
+	c.pushImm(a, pathVir);
+	a.call(c.ConvPath);
+	a.emit(0x83, 0xC4, 0x04, 0x85, 0xC0); a.jcc(0x84, missingLabel);
+	a.emit(0x50, 0x8B, 0xCB);
+	a.call(c.LoadSurface);
+	a.emit(0x85, 0xC0); a.jcc(0x84, missingLabel);
+};
+
+ItemCollectionUIStatic.emitDrawFull = function(a, pathVir, x, y, label)
+{
+	const c = ItemCollectionUIStatic;
+	const done = `${label}_done`;
+	c.emitLoadSurface(a, pathVir, done);
+	c.pushImm(a, 0);
+	a.emit(0x50);
+	c.pushImm(a, y);
+	c.pushImm(a, x);
+	a.emit(0x8B, 0xCE);
+	a.call(c.ImageDraw);
+	a.label(done);
+};
