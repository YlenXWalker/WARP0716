+ItemCollectionUIStatic.buildFormatU32Commas = function()
+{
+	const c = ItemCollectionUIStatic;
+	const a = c.asm();
+	// stdcall(value,target). A uint32 needs at most 10 digits plus three
+	// separators. Build backward in a fixed 16-byte local buffer, then copy the
+	// resulting NUL-terminated string. No locale or unbounded sprintf is used.
+	a.emit(0x55, 0x8B, 0xEC, 0x53, 0x56, 0x57, 0x83, 0xEC, 0x10);
+	a.emit(0x8B, 0x75, 0x0C, 0x85, 0xF6); a.jcc(0x84, "done");
+	a.emit(0x8D, 0x7C, 0x24, 0x0F, 0xC6, 0x07, 0x00, 0x4F);
+	a.emit(0x8B, 0x45, 0x08, 0x85, 0xC0); a.jcc(0x85, "digits");
+	a.emit(0xC6, 0x07, 0x30, 0x4F); a.jmp("copy_prepare");
+	a.label("digits");
+	a.emit(0x33, 0xDB);
+	a.label("digit_loop");
+	a.emit(0x33, 0xD2, 0xB9); a.dword(10);
+	a.emit(0xF7, 0xF1, 0x80, 0xC2, 0x30, 0x88, 0x17, 0x4F, 0x43);
+	a.emit(0x85, 0xC0); a.jcc(0x84, "copy_prepare");
+	a.emit(0x83, 0xFB, 0x03); a.jcc(0x85, "digit_loop");
+	a.emit(0xC6, 0x07, 0x2C, 0x4F, 0x33, 0xDB); a.jmp("digit_loop");
+	a.label("copy_prepare");
+	a.emit(0x47);
+	a.label("copy_loop");
+	a.emit(0x8A, 0x07, 0x88, 0x06, 0x47, 0x46, 0x84, 0xC0);
+	a.jcc(0x85, "copy_loop");
+	a.label("done");
+	a.emit(0x83, 0xC4, 0x10, 0x5F, 0x5E, 0x5B, 0x5D, 0xC2, 0x08, 0x00);
+	return a;
+};
