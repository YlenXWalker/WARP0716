+	a.emit(0x8A, 0x14, 0x0B, 0x3A, 0x14, 0x0F);
+	a.jcc(0x85, "sync_changed");
+	a.emit(0x84, 0xD2); a.jcc(0x84, "debounce");
+	a.emit(0x41); a.jmp("sync_compare");
