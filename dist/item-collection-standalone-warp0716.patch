+ItemCollectionUIStatic.emitText = function(
+	a, textVir, x, y, color, bold = 0, count = 0
+)
+{
+	const c = ItemCollectionUIStatic;
+	if (!Number.isInteger(textVir) || textVir <= 0)
+		throw Error("ItemCollectionUI: invalid native text pointer");
+	// Match the stock TextDraw ABI used by the Inventory Zeny panel visible
+	// beside Game Settings: font selector 0, height 11. Selector 1 is a
+	// different client font path and remains visibly smaller even at height 12.
+	c.pushImm(a, 0);
+	c.pushImm(a, bold);
+	c.pushImm(a, color);
+	c.pushImm(a, c.TextHeight);
+	c.pushImm(a, c.TextFontSelector);
+	c.pushImm(a, count);
+	c.pushImm(a, textVir);
+	c.pushImm(a, y);
+	c.pushImm(a, x);
+	a.emit(0x8B, 0xCE);
+	a.call(c.TextDraw);
+};
