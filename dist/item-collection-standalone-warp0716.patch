+ItemCollectionUIStatic.buildFillRect = function()
+{
+	const c = ItemCollectionUIStatic;
+	const a = c.asm();
+	// stdcall(window,x,y,width,height,color). Preserve every x86 callee-saved
+	// register and reject empty/signed-invalid rectangles before DEC/JNZ loops.
+	// Clip against the live window height and surface stride so a malformed or
+	// over-complete snapshot can never turn a paint operation into an OOB write.
+	a.emit(0x55, 0x8B, 0xEC, 0x53, 0x56, 0x57);
+	a.emit(0x8B, 0x75, 0x08, 0x85, 0xF6); a.jcc(0x84, "done");
+	a.emit(0x8B, 0x45, 0x10, 0x85, 0xC0); a.jcc(0x88, "done");
+	a.emit(0x8B, 0x55, 0x18, 0x85, 0xD2); a.jcc(0x8E, "done");
+	a.emit(0x8B, 0x4E, c.WindowHeightOffset, 0x2B, 0xC8, 0x85, 0xC9);
+	a.jcc(0x8E, "done");
+	a.emit(0x3B, 0xD1); a.jcc(0x8E, "height_ok");
+	a.emit(0x89, 0x4D, 0x18);
+	a.label("height_ok");
+	a.emit(0x8B, 0x76, c.WindowSurfaceOffset);
+	a.emit(0x85, 0xF6); a.jcc(0x84, "done");
+	a.emit(0x8B, 0x7E, c.SurfacePixelsOffset, 0x85, 0xFF);
+	a.jcc(0x84, "done");
+	a.emit(0x8B, 0x5E, c.SurfaceWidthOffset, 0x85, 0xDB);
+	a.jcc(0x8E, "done");
+	a.emit(0x8B, 0x45, 0x0C, 0x85, 0xC0); a.jcc(0x88, "done");
+	a.emit(0x8B, 0x55, 0x14, 0x85, 0xD2); a.jcc(0x8E, "done");
+	a.emit(0x8B, 0xCB, 0x2B, 0xC8, 0x85, 0xC9); a.jcc(0x8E, "done");
+	a.emit(0x3B, 0xD1); a.jcc(0x8E, "width_ok");
+	a.emit(0x89, 0x4D, 0x14);
+	a.label("width_ok");
+	a.emit(0x8B, 0x45, 0x10, 0x0F, 0xAF, 0xC3, 0x03, 0x45, 0x0C);
+	a.emit(0x8D, 0x3C, 0x87, 0x8B, 0x55, 0x18);
+	a.label("row");
+	a.emit(0x8B, 0x4D, 0x14, 0x8B, 0xC7);
+	a.label("pixel");
+	a.emit(0x8B, 0x75, 0x1C, 0x89, 0x30, 0x83, 0xC0, 0x04, 0x49);
+	a.jcc(0x85, "pixel");
+	a.emit(0x8D, 0x3C, 0x9F, 0x4A); a.jcc(0x85, "row");
+	a.label("done");
+	a.emit(0x5F, 0x5E, 0x5B, 0x5D, 0xC2, 0x18, 0x00);
+	return a;
+};
