+  MissingArtwork:
+    File: reused/artwork/fallback_question_mark.bmp
+    RuntimeOriginal: 'collection\»ç°ú.bmp'
+    Size: { Width: 75, Height: 100 }
+
+DynamicArtwork:
+  PathFormat: 'collection\<identified-resource-stem>.bmp'
+  ItemFallbackPathFormat: 'item\<identified-resource-stem>.bmp'
+  Width: 75
+  Height: 100
+  Opaque: true
+  ManualItemIdMap: false
+
+RuntimeDrawn:
+  - Window title
+  - Tab, item-category dropdown, filter, button, and status labels
+  - Search query
+  - Item and combo names
+  - IDs, counts, fees, Zeny, and bonus strings
+  - Progress rails and fills
+  - Selection, panel, card, and group borders
+  - Quantity field and hit rectangles
+  - Missing-state grayscale effect
