+ItemCollectionUIStatic.emitCenteredText = function(
+	a, textVir, left, y, width, color, bold = 0
+)
+{
+	const c = ItemCollectionUIStatic;
+	a.emit(0x53);
+	c.pushImm(a, 0);
+	c.pushImm(a, bold);
+	c.pushImm(a, c.TextHeight);
+	c.pushImm(a, c.TextFontSelector);
+	c.pushImm(a, 0);
+	c.pushImm(a, textVir);
+	a.emit(0x8B, 0xCE);
+	a.call(c.TextWidth);
+	a.emit(0xBB); a.dword(width);
+	a.emit(0x2B, 0xD8, 0xD1, 0xFB, 0x81, 0xC3); a.dword(left);
+	c.pushImm(a, 0);
+	c.pushImm(a, bold);
+	c.pushImm(a, color);
+	c.pushImm(a, c.TextHeight);
+	c.pushImm(a, c.TextFontSelector);
+	c.pushImm(a, 0);
+	c.pushImm(a, textVir);
+	c.pushImm(a, y);
+	a.emit(0x53, 0x8B, 0xCE);
+	a.call(c.TextDraw);
+	a.emit(0x5B);
+};
