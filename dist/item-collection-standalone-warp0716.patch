+	a.emit(0x3B, 0xC6, 0x0F, 0x94, 0xC0, 0x0F, 0xB6, 0xC0);
+	a.emit(0xA3); a.dword(stateVir + c.StateSearchFocused);
+	a.emit(0x8B, 0xCE);
