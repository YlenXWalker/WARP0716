+	a.emit(0xA3); a.dword(stateVir + c.StateSearchSubmitDue);
+	a.emit(0xC7, 0x05); a.dword(stateVir + c.StateSearchSubmitPending); a.dword(1);
+	a.emit(0xA1); a.dword(stateVir + c.StateWindow);
+	a.emit(0x85, 0xC0); a.jcc(0x84, "debounce");
+	a.emit(0xC7, 0x40, c.WindowDirtyOffset); a.dword(1);
+	a.jmp("debounce");
+	a.label("sync_focus_clear");
+	a.emit(0xC7, 0x05); a.dword(stateVir + c.StateSearchFocused); a.dword(0);
+	a.label("debounce");
+	a.emit(0x83, 0x3D); a.dword(stateVir + c.StateMutationPending); a.emit(1);
+	a.jcc(0x84, "done");
+	a.emit(0x83, 0x3D); a.dword(stateVir + c.StateSearchSubmitPending); a.emit(1);
+	a.jcc(0x85, "done");
+	a.emit(0xFF, 0x15); a.dword(timeGetTimeIat);
+	a.emit(0x2B, 0x05); a.dword(stateVir + c.StateSearchSubmitDue);
+	a.jcc(0x88, "done");
+	a.emit(0xC7, 0x05); a.dword(stateVir + c.StateSearchSubmitPending); a.dword(0);
+	a.emit(0xC7, 0x05); a.dword(stateVir + c.StatePage); a.dword(0);
+	a.emit(0xC7, 0x05); a.dword(stateVir + c.StateSelectedIndex); a.dword(0);
+	c.pushImm(a, 0); c.pushImm(a, 0); c.pushImm(a, c.ActionNone);
+	c.pushImm(a, c.MessageNavigate); a.call(senderVir);
+	a.emit(0xA1); a.dword(stateVir + c.StateWindow);
+	a.emit(0x85, 0xC0); a.jcc(0x84, "done");
+	a.emit(0xC7, 0x40, c.WindowDirtyOffset); a.dword(1);
+	a.label("done");
+	a.emit(0x5F, 0x5E, 0x5B, 0x8B, 0xE5, 0x5D, 0xC3);
+	return a;
+};
