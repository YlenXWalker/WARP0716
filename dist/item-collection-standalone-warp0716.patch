+ItemCollectionUIStatic.buildSnapshotReceiver = function(stateVir, payloadVir)
+{
+	const c = ItemCollectionUIStatic;
+	const a = c.asm();
+	a.emit(0x9C, 0x60);
+	a.emit(0xBE); a.dword(c.PacketBuffer);
+	a.emit(0x66, 0x81, 0x3E); a.word(c.ServerPacketId);
+	a.jcc(0x85, "handled");
+	a.emit(0x0F, 0xB7, 0x4E, 0x02);
+	a.emit(0x81, 0xF9); a.dword(c.SnapshotHeaderSize);
+	a.jcc(0x82, "handled");
+	a.emit(0x81, 0xF9); a.dword(c.SnapshotMaximumSize);
+	a.jcc(0x87, "handled");
+	a.emit(0x81, 0x7E, 0x04); a.dword(c.PacketMagic);
+	a.jcc(0x85, "handled");
+	a.emit(0x66, 0x83, 0x7E, 0x08, c.ProtocolVersion);
+	a.jcc(0x85, "handled");
+	a.emit(0x66, 0x83, 0x7E, 0x0A, c.MessageSnapshot);
+	a.jcc(0x85, "handled");
+
+	// COUI is request/response scoped. Accept only the currently outstanding
+	// request and never move backward from an already accepted request or
+	// revision. This prevents a late silent-storage resume from restoring an
+	// older tab, page, payload, or selection after a newer navigation.
+	a.emit(0x8B, 0x46, 0x0C);
+	a.emit(0x3B, 0x05); a.dword(stateVir + c.StateRequest);
+	a.jcc(0x82, "handled");
+	a.jcc(0x87, "handled");
+	a.emit(0x3B, 0x05); a.dword(stateVir + c.StateAcceptedRequest);
