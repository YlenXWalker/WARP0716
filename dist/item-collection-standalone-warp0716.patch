+ItemCollectionStockMenuButton = function(_)
+{
+	const s = ItemCollectionStockMenuButtonStatic;
+	if (Exe.BuildDate !== s.BuildDate)
+		throw Error("ItemCollectionStockMenuButton supports only 2025-07-16");
+	if (typeof ItemCollectionUIStatic === "undefined")
+		throw Error("ItemCollectionStockMenuButton: ItemCollectionUI must run first");
+	const c = ItemCollectionUIStatic;
+	const bridge = CACHE.get("ItemCollectionUI.MenuButton.v1");
+	if (!bridge || !Number.isInteger(bridge.requestVir))
+		throw Error("ItemCollectionStockMenuButton: Item Collection bridge missing");
+
+	let style = "New UI";
+	if (!Warp.TestMode)
+	{
+		style = Exe.GetUserInput(
+			"$itemCollectionStandaloneStyle", D_Choice,
+			"Item Collection Launcher",
+			"Select the stock menu icon style.",
+			"New UI",
+			{choices: ["New UI", "Classic"], saveDefault: true}
+		);
+	}
+	const classic = style === "Classic";
+	const width = classic ? s.ClassicWidth : s.NewWidth;
+	const height = classic ? s.ClassicHeight : s.NewHeight;
+	const names = classic
+		? [
+			"bt_itemcollection_old_normal.bmp",
+			"bt_itemcollection_old_mouseon.bmp",
+			"bt_itemcollection_old_pressed.bmp"
+		]
+		: [
+			"bt_itemcollection_normal.bmp",
+			"bt_itemcollection_mouseon.bmp",
+			"bt_itemcollection_pressed.bmp"
+		];
+	const imagePaths = names.map(name => c.allocateString(
+		c.buildResourcePath("uirenewal\\menuicon\\" + name)
+	).vir);
+	const state = c.allocateBytes([0, 0, 0, 0], 4);
+	const destructor = s.allocateCode(s.buildDestructor(state.vir));
+	const mouseUp = s.allocateCode(s.buildMouseUp(bridge.requestVir));
+	const mouseDown = s.allocateCode(s.buildMouseDown());
+	const hover = s.allocateCode(s.buildHover());
+	const vtable = s.cloneButtonVtable(
+		mouseUp.vir, hover.vir, destructor.vir, mouseDown.vir
+	);
+	const ensure = s.allocateCode(
+		s.buildEnsure(state.vir, vtable.vir, imagePaths)
+	);
+	const sync = s.allocateCode(s.buildSync(state.vir, width, height));
+	const draw = s.allocateCode(s.buildDrawWrapper(ensure.vir, sync.vir));
+	const onCreate = s.allocateCode(s.buildOnCreateWrapper(ensure.vir, sync.vir));
+	const visibility = s.allocateCode(
+		s.buildVisibilityWrapper(state.vir, sync.vir)
+	);
+
+	const patches = [
+		[s.MenuDrawVtable, s.MenuDrawOriginal, draw.vir],
+		[s.MenuOnCreateVtable, s.MenuOnCreateOriginal, onCreate.vir],
+		[s.MenuVisibilityVtable, s.MenuVisibilityOriginal, visibility.vir]
+	];
+	for (const [entryVir, expected, replacement] of patches)
+	{
+		const entryPhy = Exe.Vir2Phy(entryVir);
+		if (entryPhy < 0 || Exe.GetUint32(entryPhy) !== expected)
+			throw Error(`ItemCollectionStockMenuButton: vtable changed at ${entryVir.toHex(true)}`);
+		Exe.SetUint32(entryPhy, replacement);
+	}
+	return true;
+};
