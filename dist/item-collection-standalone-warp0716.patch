+    MiddleSliceRepeatsVertically: true
+  Steppers:
+    Root: reused/steppers
+    Files: 'btn_{plus,minus}_{normal,over,press}.bmp'
+  Currency:
+    File: reused/currency/icon_zeny.bmp
+  NativeCompletedRibbon:
+    File: reused/status/badge_complete.bmp
