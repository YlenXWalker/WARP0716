+	a.emit(0x33, 0xC9);
+	a.label("sync_copy");
+	a.emit(0x83, 0xF9, c.SearchMaximumChars); a.jcc(0x8D, "sync_terminate");
+	a.emit(0x8A, 0x14, 0x0B, 0x88, 0x14, 0x0F);
+	a.emit(0x84, 0xD2); a.jcc(0x84, "sync_copied");
+	a.emit(0x41); a.jmp("sync_copy");
