+	a.emit(0x8B, 0xCE); a.call(ensureVir);
+	a.emit(0x8B, 0xCE); a.call(syncVir);
+	a.emit(0x8B, 0xCE); a.call(s.MenuDrawOriginal);
+	a.emit(0x5E, 0x5B, 0x8B, 0xE5, 0x5D, 0xC3);
